# Instapaper OAuth credentials
INSTAPAPER_KEY=your_consumer_key
INSTAPAPER_SECRET=your_consumer_secret
INSTAPAPER_USERNAME=your_email@example.com
INSTAPAPER_PASSWORD=your_password

# Kindle delivery
KINDLE_EMAIL=your_username@kindle.com

# SMTP configuration (example: Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SENDER_EMAIL=your_email@gmail.com

# Runtime options
POLL_INTERVAL=900
LOG_LEVEL=info
